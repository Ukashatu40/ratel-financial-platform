// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

// M0 only needs enough for the shared kernel (Outbox) to compile against.
// Full domain schema (expenses, payroll, etc.) lands with M1/M2 per Phase 6.

// ENUMS

enum OutboxStatus {
  pending
  dispatched
  failed
}

enum PeriodStatus {
  open
  closing
  closed
  reopened
}

enum ExpenseStatus {
  draft
  pending_approval
  approved
  rejected
  cancelled
  closed
}

enum ExpenseSourceType {
  manual
  employee
  accountant
  import
  integration
}

enum ApprovalDecision {
  approved
  rejected
}

enum PayrollRunStatus {
  draft
  pending_approval
  approved
  processing
  completed
  cancelled
}

enum RoleName {
  employee
  accountant
  department_head
  finance_director
  payroll_admin
  auditor
}

enum PermissionScope {
  own
  department
  organization
}

enum ImportJobStatus {
  pending
  processing
  completed
  failed
}

enum ScanStatus {
  unscanned // no real virus scanner integrated yet — explicit, not pretending
  clean
  infected
}

enum NotificationChannel {
  email
  sms
}

enum NotificationStatus {
  pending
  sent
  failed
}

// MODELS
model OutboxEvent {
  id            String       @id @default(uuid())
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  eventType     String       @map("event_type")
  payload       Json
  status        OutboxStatus @default(pending)

  // Request-context metadata, captured once at enqueue time (never on the
  // DomainEvent itself — keeps the domain layer free of HTTP concerns per
  // Phase 4.3). OutboxDispatchService reads these back out when building
  // the audit entry, below.
  correlationId String       @map("correlation_id")
  requestId     String?      @map("request_id")
  ipAddress     String?      @map("ip_address")
  userAgent     String?      @map("user_agent")
  source        String       @default("background_worker")

  createdAt    DateTime      @default(now()) @map("created_at")
  dispatchedAt DateTime?     @map("dispatched_at")

  @@index([status, createdAt])
  @@map("outbox_events")
}

// Minimal stub — full Organization model (with settings, currency defaults,
// etc.) lands when we do the reference-tables pass. Only what FinancialPeriod
// needs as a FK target exists here for now.
model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  financialPeriods FinancialPeriod[]

  @@map("organizations")
}

// Extend the existing User stub with auth fields
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  employee Employee?
  createdAt    DateTime @default(now()) @map("created_at")

  closedPeriods    FinancialPeriod[] @relation("PeriodClosedBy")
  roleAssignments  UserRoleAssignment[]
  refreshTokens    RefreshToken[]

  @@map("users")
}

// A user can hold multiple roles (e.g. an Accountant who is ALSO a
// department head for their own team). departmentId is only meaningful for
// department-scoped roles (department_head) — null for org-scoped roles.
model UserRoleAssignment {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           RoleName
  departmentId   String?  @map("department_id")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, role, departmentId])
  @@index([userId])
  @@map("user_role_assignments")
}

// Phase 9.1's permission matrix, made literal data rather than a code
// switch — editing a role's permissions is a data change, not a deploy.
model RolePermission {
  id         String          @id @default(uuid())
  role       RoleName
  permission String          // e.g. 'expense:approve'
  scope      PermissionScope

  @@unique([role, permission])
  @@map("role_permissions")
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  // Hashed, never plaintext — a leaked DB dump shouldn't hand out live
  // sessions (Phase 9.2).
  tokenHash   String   @unique @map("token_hash")
  expiresAt   DateTime @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model FinancialPeriod {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  startDate      DateTime     @db.Date @map("start_date")
  endDate        DateTime     @db.Date @map("end_date")
  status         PeriodStatus @default(open)
  closedById     String?      @map("closed_by")
  closedAt       DateTime?    @map("closed_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  closedBy     User?        @relation("PeriodClosedBy", fields: [closedById], references: [id])
  expenses Expense[]
  payrollRuns PayrollRun[]

  @@unique([organizationId, startDate, endDate], name: "uq_org_period")
  @@index([organizationId, status])
  @@map("financial_periods")
}

// --- Minimal reference-table stubs (full detail deferred to the
// reference-tables pass, per the same pattern used for Organization/User
// in Financial Period) ---

model Department {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  expenses Expense[]

  @@unique([organizationId, name])
  @@map("departments")
}

model Vendor {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  expenses Expense[]

  @@unique([organizationId, name])
  @@map("vendors")
}

model Project {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  expenses Expense[]

  @@unique([organizationId, name]) // NEW — Project never had this; adding for consistency with the other three
  @@map("projects")
}

model ExpenseCategory {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  expenses Expense[]

  @@unique([organizationId, name])
  @@map("expense_categories")
}

// Atomic per-organization counter backing ExpenseRepository.nextExpenseNumber().
// A separate table rather than a Postgres SEQUENCE because sequences are
// global/unscoped by default — this keeps numbering scoped per organization_id,
// which matters once multi-tenancy is real (Phase 1.3 groundwork).
model ExpenseNumberSequence {
  organizationId String @id @map("organization_id")
  nextValue      Int    @default(1) @map("next_value")

  @@map("expense_number_sequences")
}

model Expense {
  id                 String            @default(uuid())
  organizationId     String            @map("organization_id")
  expenseNumber      String            @map("expense_number")
  status             ExpenseStatus     @default(draft)
  sourceType         ExpenseSourceType @map("source_type")
  sourceActorId      String            @map("source_actor_id")
  sourceImportJobId  String?           @map("source_import_job_id")
  amountMinorUnits   BigInt            @map("amount_minor_units")
  currency           String            @db.Char(3) @default("NGN")
  categoryId         String            @map("category_id")
  vendorId           String?           @map("vendor_id")
  departmentId       String            @map("department_id")
  projectId          String?           @map("project_id")
  periodId           String            @map("period_id")
  parentExpenseId    String?           @map("parent_expense_id")
  adjustmentReason   String?           @map("adjustment_reason")
  expenseDate        DateTime          @db.Date @map("expense_date")
  description        String?
  deletedAt          DateTime?         @map("deleted_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  category Department       @relation(fields: [departmentId], references: [id])
  vendor   Vendor?           @relation(fields: [vendorId], references: [id])
  project  Project?          @relation(fields: [projectId], references: [id])
  expenseCategory ExpenseCategory @relation(fields: [categoryId], references: [id])
  period   FinancialPeriod   @relation(fields: [periodId], references: [id])

  @@id([id, expenseDate]) // composite PK required by range partitioning (Phase 6.2)
  @@unique([organizationId, expenseNumber])
  @@index([organizationId, departmentId, status])
  @@index([organizationId, vendorId])
  @@index([organizationId, projectId])
  @@index([periodId])
  @@index([parentExpenseId])
  @@map("expenses")
}

model ApprovalProgress {
  id        String   @id @default(uuid())
  itemId    String   @unique @map("item_id")
  itemType  String   @map("item_type") // 'Expense' | 'PayrollRun' (future)
  chain     Json     // snapshot of ApprovalChain at initialization time —
                      // deliberately frozen, so a mid-flight approval isn't
                      // silently affected by a policy change (e.g. threshold
                      // edit) that happens after the item was submitted
  createdAt DateTime @default(now()) @map("created_at")

  records ApprovalRecord[]

  @@map("approval_progress")
}

model ApprovalRecord {
  id          String           @id @default(uuid())
  progressId  String           @map("progress_id")
  stepOrder   Int              @map("step_order")
  approverId  String           @map("approver_id")
  decision    ApprovalDecision
  reason      String?
  decidedAt   DateTime         @default(now()) @map("decided_at")

  progress ApprovalProgress @relation(fields: [progressId], references: [id])

  @@unique([progressId, stepOrder])
  @@map("approval_records")
}

model Employee {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  fullName       String   @map("full_name")
  userId         String?  @unique @map("user_id") // NEW — nullable: an Employee can exist for payroll purposes without ever having platform login access (e.g. a contractor paid via payroll but never given system access)
  createdAt      DateTime @default(now()) @map("created_at")

  user             User?             @relation(fields: [userId], references: [id])
  salaryStructures SalaryStructure[]
  payslips         Payslip[]

  @@map("employees")
}

model SalaryStructure {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  employeeId     String    @map("employee_id")
  version        Int
  effectiveFrom  DateTime  @db.Date @map("effective_from")
  effectiveTo    DateTime? @db.Date @map("effective_to") // null = currently active

  // baseSalaryLineItems, field-level encrypted (Phase 9.3 / piece 3.5) —
  // this is raw compensation data, so it never lands in a plaintext column,
  // unlike the reference tables above.
  encryptedLineItems Bytes @map("encrypted_line_items")

  createdAt DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, version])
  @@index([employeeId, effectiveTo]) // effectiveTo IS NULL lookups (active structure) hit this
  @@map("salary_structures")
}

model PayrollRun {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  periodId       String           @map("period_id")
  status         PayrollRunStatus @default(draft)
  runMonth       DateTime         @db.Date @map("run_month")
  createdById    String           @map("created_by")
  approvedById   String?          @map("approved_by")
  approvedAt     DateTime?        @map("approved_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  period   FinancialPeriod @relation(fields: [periodId], references: [id])
  payslips Payslip[]

  @@unique([organizationId, runMonth])
  @@index([organizationId, status])
  @@map("payroll_runs")
}

model Payslip {
  id               String   @id @default(uuid())
  payrollRunId     String   @map("payroll_run_id")
  employeeId       String   @map("employee_id")
  grossPayMinorUnits BigInt @map("gross_pay_minor_units")
  netPayMinorUnits   BigInt @map("net_pay_minor_units")
  currency         String   @db.Char(3) @default("NGN")

  // Combined { salaryStructureSnapshot, lineItems, taxComputation } as one
  // encrypted JSON blob (Phase 9.3) — gross/net stay plaintext above
  // specifically so reporting/reconciliation can aggregate without
  // decrypting every row, per the original Phase 6.2 schema rationale.
  encryptedDetail  Bytes    @map("encrypted_detail")

  createdAt        DateTime @default(now()) @map("created_at")

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id])
  employee   Employee   @relation(fields: [employeeId], references: [id])

  @@unique([payrollRunId, employeeId])
  @@map("payslips")
}

model AuditLogEntry {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  action         String
  actorUserId    String?  @map("actor_user_id")
  oldValue       Json?    @map("old_value")
  newValue       Json?    @map("new_value")
  reason         String?
  correlationId  String   @map("correlation_id")
  requestId      String?  @map("request_id")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  source         String
  prevHash       String   @map("prev_hash")
  entryHash      String   @map("entry_hash")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([correlationId])
  @@map("audit_log_entries")
}

model ExpenseReadModel {
  expenseId        String   @id
  organizationId   String   @map("organization_id")
  departmentId     String   @map("department_id")
  departmentName   String   @map("department_name")
  categoryId       String   @map("category_id")
  categoryName     String   @map("category_name")
  vendorId         String?  @map("vendor_id")
  vendorName       String?  @map("vendor_name")
  projectId        String?  @map("project_id")
  projectName String? @map("project_name")
  amountMinorUnits BigInt   @map("amount_minor_units") // SIGNED — adjustments carry negative values,
                                                         // so summing this column naturally nets out
                                                         // reversals against originals, no special-casing
  currency         String   @db.Char(3)
  status           String
  expenseDate      DateTime @db.Date @map("expense_date")
  parentExpenseId  String?  @map("parent_expense_id")
  createdAt        DateTime @map("created_at")
  updatedAt        DateTime @map("updated_at")

  @@index([organizationId, projectId, status, expenseDate])
  @@index([organizationId, departmentId, status, expenseDate])
  @@index([organizationId, categoryId, status, expenseDate])
  @@index([organizationId, vendorId, status, expenseDate])
  @@map("expense_read_model")
}

model ImportJob {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  providerId     String          @map("provider_id") // 'csv-upload' today; future connectors add their own
  status         ImportJobStatus @default(pending)
  initiatedById  String          @map("initiated_by")
  storageKey     String          @map("storage_key") // was: rawContent String @db.Text
  totalRecords   Int?            @map("total_records")
  successCount   Int             @default(0) @map("success_count")
  failureCount   Int             @default(0) @map("failure_count")
  createdAt      DateTime        @default(now()) @map("created_at")
  completedAt    DateTime?       @map("completed_at")

  failedRecords FailedImportRecord[]

  @@index([organizationId, status])
  @@map("import_jobs")
}

model InboxRecord {
  importJobId      String   @map("import_job_id")
  sourceRecordHash String   @map("source_record_hash")
  processedAt      DateTime @default(now()) @map("processed_at")

  @@id([importJobId, sourceRecordHash])
  @@map("inbox_records")
}

model FailedImportRecord {
  id           String   @id @default(uuid())
  importJobId  String   @map("import_job_id")
  rowNumber    Int      @map("row_number")
  rawRow       Json     @map("raw_row")
  errorMessage String   @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")

  importJob ImportJob @relation(fields: [importJobId], references: [id])

  @@map("failed_import_records")
}
model Attachment {
  id             String     @id @default(uuid())
  expenseId      String     @map("expense_id")
  organizationId String     @map("organization_id")
  storageKey     String     @map("storage_key")
  fileName       String     @map("file_name")
  contentType    String     @map("content_type")
  sizeBytes      Int        @map("size_bytes")
  uploadedById   String     @map("uploaded_by")
  scanStatus     ScanStatus @default(unscanned) @map("scan_status")
  createdAt      DateTime   @default(now()) @map("created_at")

  @@index([expenseId])
  @@map("attachments")
}

model NotificationLog {
  id              String              @id @default(uuid())
  organizationId  String              @map("organization_id")
  recipientUserId String              @map("recipient_user_id")
  channel         NotificationChannel
  templateType    String              @map("template_type")
  templateData    Json                @map("template_data") // NEW — required to reconstruct a retry
  status          NotificationStatus  @default(pending)
  errorMessage    String?             @map("error_message")
  createdAt       DateTime            @default(now()) @map("created_at")
  sentAt          DateTime?           @map("sent_at")

  @@index([recipientUserId])
  @@index([organizationId, status])
  @@map("notification_logs")
}
