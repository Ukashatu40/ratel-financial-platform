# .env.production.example
#
# Copy to `.env` next to docker-compose.prod.yml on the VPS and fill in
# every value below. This file is read BOTH by docker-compose.prod.yml
# itself (${VAR} interpolation, for the infra services) and by the app
# container (env_file:) — one file, one source of truth.
#
# Secrets posture (confirmed decision): plain .env file, no KMS/Vault/SOPS.
# Lock it down hard instead:
#   chown root:root .env && chmod 600 .env
# and make sure it is NEVER committed (already covered by .gitignore) and
# NEVER baked into the Docker image (.dockerignore already excludes .env*).
# Only the user that runs `docker compose` on the VPS should be able to
# read it.

NODE_ENV=production
PORT=3000

# --- Postgres (compose-level; app's own DATABASE_URL is set for you by
#     docker-compose.prod.yml itself using the two RATEL_APP_DB_* vars
#     below — do not set DATABASE_URL here, it would be overridden anyway) ---
# Superuser password, used only by migrations/seed/backup/restore — the
# running app never connects as this user.
POSTGRES_PASSWORD=change-me-generate-a-long-random-value
# Least-privilege role the running app actually connects as (TECH_DEBT #4).
# Created automatically on first Postgres init by ops/db/init-app-role.sh.
RATEL_APP_DB_USER=ratel_app
RATEL_APP_DB_PASSWORD=change-me-generate-a-long-random-value

# --- Redis ---
REDIS_PASSWORD=change-me-generate-a-long-random-value
# REDIS_HOST/REDIS_PORT are overridden to redis:6379 by
# docker-compose.prod.yml itself — no need to set them here.

# --- JWT (each MUST be >= 32 chars — generate with: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=change-me-generate-a-long-random-value
JWT_REFRESH_SECRET=change-me-generate-a-long-random-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Object storage (MinIO, internal-only — see docker-compose.prod.yml) ---
OBJECT_STORAGE_BUCKET=ratel-financial-attachments
OBJECT_STORAGE_ACCESS_KEY=change-me-generate-a-long-random-value
OBJECT_STORAGE_SECRET_KEY=change-me-generate-a-long-random-value
# OBJECT_STORAGE_ENDPOINT is overridden to http://minio:9000 by
# docker-compose.prod.yml itself — no need to set it here.

# --- Field-level encryption (payroll salary data) ---
# Base64-encoded 32-byte key. Generate with: openssl rand -base64 32
# Confirmed decision: plain .env, no KMS — see the secrets posture note
# above. Losing this key makes existing encrypted salary data
# unrecoverable, and it CANNOT be rotated by just changing this value
# (existing ciphertext was sealed under the old key) — treat it as
# effectively permanent once real data exists under it. Back it up
# separately from the database dump, offline, before going live.
FIELD_ENCRYPTION_MASTER_KEY=

# --- ClamAV (internal-only) ---
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# --- Observability ---
OTEL_METRICS_PORT=9464
# Leave unset unless an OTLP collector is actually running somewhere this
# VPS can reach — unset means traces are simply not exported, not an error.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Email (confirmed decision: third-party transactional provider, not
#     self-hosted SMTP) — fill in with whichever provider is chosen; any
#     provider exposing standard SMTP+auth works unchanged. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=noreply@ratel-plus.com
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# --- Rate limiting / idempotency / step-up auth ---
# Safe to leave unset — rate-limit.constants.ts / idempotency.constants.ts /
# step-up.ts defaults apply. Only override if the defaults genuinely don't
# fit observed production traffic.
# RATE_LIMIT_DEFAULT_LIMIT=
# RATE_LIMIT_DEFAULT_TTL_MS=
# RATE_LIMIT_AUTH_LIMIT=
# RATE_LIMIT_AUTH_TTL_MS=
# RATE_LIMIT_REPORTS_LIMIT=
# RATE_LIMIT_REPORTS_TTL_MS=
# IDEMPOTENCY_RESPONSE_TTL_MS=
# IDEMPOTENCY_LOCK_TTL_MS=
# STEP_UP_WINDOW_MS=

# --- CORS ---
# No domain/frontend origin decided yet — leave CORS_ORIGINS unset (CORS
# stays fully disabled, the safe default) until a real frontend origin
# exists, then set it to that exact origin, e.g.
# CORS_ORIGINS=https://app.ratel-plus.com
CORS_ORIGINS=
CORS_CREDENTIALS=false

# --- Production seed (ops/deploy/deploy.sh / prisma:seed:production) ---
# Creates exactly one real finance_director admin account on first deploy
# only — re-running never overwrites an existing password. Use this
# account to log in and create real departments/vendors/projects/
# categories/employees through the API.
RATEL_ORG_NAME=Ratel-Plus Nigeria Ltd
RATEL_ADMIN_EMAIL=admin@ratel-plus.com
RATEL_ADMIN_PASSWORD=change-me-generate-a-long-random-value

# --- Backups (ops/backup/backup-postgres.sh) ---
# Confirmed decision: local-only on this VPS for now.
# RATEL_BACKUP_DIR=/var/backups/ratel-financial
# RATEL_BACKUP_RETENTION_DAYS=14

# --- Monitoring (optional — only needed if docker-compose.monitoring.yml
#     is started) ---
# GRAFANA_ADMIN_PASSWORD=change-me-generate-a-long-random-value
